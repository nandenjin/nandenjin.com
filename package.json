{
  "name": "@nandenjin/nandenjin.com",
  "version": "2.5.2",
  "description": "https://www.nandenjin.com/",
  "main": "index.js",
  "scripts": {
    "start": "nuxt start",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "deploy": "firebase deploy",
    "content": "run-s clean content:*",
    "content:fetch": "git clone -b master --depth 1 https://github.com/nandenjin/portfolio.git content",
    "lint": "eslint --ext ts,js,vue .",
    "lintfix": "eslint --ext ts,js,vue . --fix",
    "format": "prettier --write \"./**/*.{js,ts,json,vue,md,yml}\"",
    "clean": "rimraf content"
  },
  "repository": {
    "type": "git",
    "url": "git+https://nandenjin@github.com/nandenjin/nandenjin.com.git"
  },
  "author": "Kazumi Inada <hello@nandenjin.com>",
  "license": "UNLICENSED",
  "dependencies": {
    "@nuxt/content": "1.15.1",
    "@nuxt/types": "2.18.1",
    "@nuxtjs/google-analytics": "2.4.0",
    "@nuxtjs/gtm": "2.4.0",
    "@nuxtjs/sitemap": "2.4.0",
    "normalize.css": "8.0.1",
    "nuxt": "2.17.3"
  },
  "devDependencies": {
    "@nuxt/typescript-build": "3.0.2",
    "@types/resize-observer-browser": "0.1.11",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "consola": "3.4.2",
    "es6-promise-pool": "2.5.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "firebase-tools": "15.3.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "npm-run-all2": "8.0.4",
    "nuxt-property-decorator": "2.9.1",
    "rimraf": "6.1.2",
    "sass": "1.97.2",
    "sass-loader": "10.5.2",
    "sharp": "0.34.5",
    "simple-git": "3.30.0",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.2.0",
    "vue-property-decorator": "9.1.2"
  },
  "private": true,
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,vue}": "eslint --cache --fix",
    "*.{ts,js,vue,md,yml,json}": "prettier --write"
  },
  "resolutions": {
    "**/@nuxt/types": "2.18.1"
  }
}
